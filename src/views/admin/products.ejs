<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <p class="eyebrow">Manage your catalog</p>
  <h1>Products & inventory</h1>

  <div class="card">
    <h2>Add a product</h2>
    <form method="POST" action="/admin/products" class="form-grid">
      <label>Product name <input type="text" name="name" required /></label>
      <label>Barcode <input type="text" name="barcode" /></label>
      <label>Category
        <select name="category_id">
          <option value="">Uncategorized</option>
          <% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
        </select>
      </label>
      <label>Unit <input type="text" name="unit" value="pc" /></label>
      <label>Cost price <input type="number" step="0.01" min="0" name="cost_price" value="0" /></label>
      <label>Selling price <input type="number" step="0.01" min="0" name="selling_price" required /></label>
      <label>Stock quantity <input type="number" min="0" name="stock_quantity" value="0" /></label>
      <label>Low-stock alert at <input type="number" min="0" name="reorder_level" value="5" /></label>
      <button type="submit" class="btn btn-primary">Add product</button>
    </form>
  </div>

  <div class="card" id="inventory">
    <h2>Inventory overview</h2>
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr><th>Product</th><th>Category</th><th>Unit</th><th>Cost</th><th>Price</th><th>Stock</th><th>Low-stock at</th><th>Available</th><th></th></tr>
        </thead>
        <tbody>
          <% products.forEach(p => { %>
            <% const fid = 'product-form-' + p.id %>
            <tr class="<%= !p.active ? 'row-muted' : (p.stock_quantity <= p.reorder_level ? 'row-warning' : '') %>">
              <td><input form="<%= fid %>" type="text" name="name" value="<%= p.name %>" required aria-label="Product name" /></td>
              <td>
                <select form="<%= fid %>" name="category_id" aria-label="Category">
                  <option value="">Uncategorized</option>
                  <% categories.forEach(c => { %>
                    <option value="<%= c.id %>" <%= String(c.id) === String(p.category_id) ? 'selected' : '' %>><%= c.name %></option>
                  <% }) %>
                </select>
              </td>
              <td><input form="<%= fid %>" type="text" name="unit" value="<%= p.unit %>" aria-label="Unit" /></td>
              <td><input form="<%= fid %>" type="number" min="0" step="0.01" name="cost_price" value="<%= p.cost_price %>" aria-label="Cost price" /></td>
              <td><input form="<%= fid %>" type="number" min="0" step="0.01" name="selling_price" value="<%= p.selling_price %>" aria-label="Selling price" /></td>
              <td>
                <input form="<%= fid %>" type="number" min="0" name="stock_quantity" value="<%= p.stock_quantity %>" aria-label="Stock quantity" />
                <% if (p.active && p.stock_quantity <= p.reorder_level) { %><small class="stock-alert">Low stock</small><% } %>
              </td>
              <td><input form="<%= fid %>" type="number" min="0" name="reorder_level" value="<%= p.reorder_level %>" aria-label="Low-stock alert level" /></td>
              <td><input form="<%= fid %>" type="checkbox" name="active" value="1" <%= p.active ? 'checked' : '' %> aria-label="Product available" /></td>
              <td>
                <form id="<%= fid %>" method="POST" action="/admin/products/<%= p.id %>"></form>
                <button form="<%= fid %>" type="submit" class="btn btn-small btn-secondary">Save</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card" id="categories">
    <h2>Categories</h2>
    <form method="POST" action="/admin/categories" class="form-inline category-create">
      <label>New category <input type="text" name="name" placeholder="e.g. Pantry" required /></label>
      <button type="submit" class="btn btn-primary">Add category</button>
    </form>
    <% if (categories.length === 0) { %>
      <p class="muted">No categories yet. Add one above to organize products.</p>
    <% } else { %>
      <div class="table-scroll">
        <table class="table">
          <thead><tr><th>Category name</th><th></th><th></th></tr></thead>
          <tbody>
            <% categories.forEach(c => { %>
              <tr>
                <td>
                  <form id="category-form-<%= c.id %>" method="POST" action="/admin/categories/<%= c.id %>"></form>
                  <input form="category-form-<%= c.id %>" type="text" name="name" value="<%= c.name %>" required aria-label="Category name" />
                </td>
                <td><button form="category-form-<%= c.id %>" class="btn btn-small btn-secondary">Save</button></td>
                <td>
                  <form method="POST" action="/admin/categories/<%= c.id %>/delete" onsubmit="return confirm('Delete this category? Products assigned to it must be reassigned first.')">
                    <button class="btn btn-small btn-danger" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
    <p class="muted">Products assigned to a category must be reassigned before it can be deleted. Unavailable products can be restored by checking Available and saving; records are retained for transaction history.</p>
  </div>
</main>
<%- include('../partials/foot') %>
