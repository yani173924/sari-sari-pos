<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <div class="page-heading">
    <div><p class="eyebrow">DailyMart overview</p><h1>Dashboard</h1></div>
    <a class="btn btn-secondary" href="/admin/daily-report">View daily report</a>
  </div>

  <div class="stat-row">
    <div class="stat-card">
      <div class="stat-label">Total products</div>
      <div class="stat-value"><%= storeTotals.product_count %></div>
      <div class="stat-sub">Active items for sale</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Categories</div>
      <div class="stat-value"><%= storeTotals.category_count %></div>
      <div class="stat-sub">Product groups</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Total sales</div>
      <div class="stat-value"><%= peso(storeTotals.sales_total) %></div>
      <div class="stat-sub">All recorded sales</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Transactions</div>
      <div class="stat-value"><%= storeTotals.transaction_count %></div>
      <div class="stat-sub">All recorded receipts</div>
    </div>
  </div>

  <section class="card">
    <div class="section-heading"><div><p class="eyebrow">Sales summary</p><h2>At a glance</h2></div></div>
    <div class="summary-chips">
      <div><span>Today</span><strong><%= peso(todayTotal.total) %></strong><small><%= todayTotal.count %> transactions</small></div>
      <div><span>Last 7 days</span><strong><%= peso(weekTotal.total) %></strong><small><%= weekTotal.count %> transactions</small></div>
      <div><span>This month</span><strong><%= peso(monthTotal.total) %></strong><small><%= monthTotal.count %> transactions</small></div>
    </div>
  </section>

  <div class="grid-2">
    <div class="card">
      <h2>Sales trend <span class="muted">· 7 days</span></h2>
      <canvas id="salesTrendChart" height="220"></canvas>
    </div>

    <div class="card">
      <h2>Top Products (30 days)</h2>
      <% if (topProducts.length === 0) { %>
        <p class="muted">No sales recorded yet.</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Product</th><th>Units</th><th>Revenue</th></tr></thead>
          <tbody>
            <% topProducts.forEach(p => { %>
              <tr>
                <td><%= p.product_name %></td>
                <td><%= p.units_sold %></td>
                <td><%= peso(p.revenue) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <h2>Inventory overview <span class="muted">· <%= storeTotals.low_stock_count %> low stock</span></h2>
      <% if (lowStock.length === 0) { %>
        <p class="muted">All products are sufficiently stocked.</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Product</th><th>Stock</th><th>Reorder Level</th></tr></thead>
          <tbody>
            <% lowStock.forEach(p => { %>
              <tr class="<%= p.stock_quantity === 0 ? 'row-danger' : 'row-warning' %>">
                <td><%= p.name %></td>
                <td><%= p.stock_quantity %> <%= p.unit %></td>
                <td><%= p.reorder_level %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="card">
      <h2>Recent transactions</h2>
      <% if (recentSales.length === 0) { %>
        <p class="muted">No transactions yet.</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Receipt</th><th>Cashier</th><th>Total</th><th>When</th></tr></thead>
          <tbody>
            <% recentSales.forEach(s => { %>
              <tr>
                <td><a href="/admin/sales/<%= s.id %>"><%= s.receipt_no %></a></td>
                <td><%= s.cashier %></td>
                <td><%= peso(s.total_amount) %></td>
                <td><%= s.created_at %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</main>

<script src="/js/vendor/chart.umd.min.js"></script>
<script>
  const trendData = <%- JSON.stringify(trendData) %>;
  const ctx = document.getElementById('salesTrendChart');
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: trendData.map(d => d.day.slice(5)),
      datasets: [{
        label: 'Sales (₱)',
        data: trendData.map(d => d.total),
        borderColor: '#6F5A91',
        backgroundColor: 'rgba(216, 193, 250, 0.35)',
        tension: 0.3,
        fill: true,
      }],
    },
    options: {
      plugins: { legend: { display: false } },
      scales: { y: { beginAtZero: true } },
    },
  });
</script>
<%- include('../partials/foot') %>
