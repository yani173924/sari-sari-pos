<% if (currentUser) { %>
<div class="app-shell">
  <aside class="sidebar">
    <a class="brand" href="<%= currentUser.role === 'admin' ? '/admin/dashboard' : '/pos' %>">
      <img src="/images/dailymart-logo.svg" alt="" />
      <span>DailyMart <small>POS</small></span>
    </a>
    <div class="nav-caption">Workspace</div>
    <nav class="side-nav" aria-label="Main navigation">
      <% if (currentUser.role === 'admin') { %>
        <a href="/admin/dashboard" aria-label="Dashboard" class="<%= title === 'Dashboard' ? 'active' : '' %>"><span class="nav-icon">⌂</span><span>Dashboard</span></a>
        <a href="/admin/products" aria-label="Products" class="<%= title === 'Products' ? 'active' : '' %>"><span class="nav-icon">▦</span><span>Products</span></a>
        <a href="/admin/products#categories" aria-label="Categories"><span class="nav-icon">▤</span><span>Categories</span></a>
        <a href="/admin/products#inventory" aria-label="Inventory"><span class="nav-icon">◫</span><span>Inventory</span></a>
        <a href="/admin/sales" aria-label="Transactions" class="<%= title === 'Sales' || title === 'Sale Detail' ? 'active' : '' %>"><span class="nav-icon">▧</span><span>Transactions</span></a>
        <a href="/admin/daily-report" aria-label="Reports" class="<%= title === 'Daily Report' ? 'active' : '' %>"><span class="nav-icon">▥</span><span>Reports</span></a>
        <a href="/admin/inventory-reports" aria-label="Inventory reports" class="<%= title === 'Inventory Reports' ? 'active' : '' %>"><span class="nav-icon">◷</span><span>Stock reports</span></a>
        <a href="/admin/users" aria-label="Settings" class="<%= title === 'Users' ? 'active' : '' %>"><span class="nav-icon">⚙</span><span>Settings</span></a>
      <% } else { %>
        <a href="/pos" aria-label="POS and Sales" class="<%= title === 'Point of Sale' ? 'active' : '' %>"><span class="nav-icon">▣</span><span>POS / Sales</span></a>
        <a href="/pos/daily-report" aria-label="Daily report" class="<%= title === 'Daily Report' ? 'active' : '' %>"><span class="nav-icon">▥</span><span>Daily report</span></a>
        <a href="/pos/inventory" aria-label="Inventory" class="<%= title === 'Inventory' ? 'active' : '' %>"><span class="nav-icon">◫</span><span>Inventory</span></a>
      <% } %>
    </nav>
    <div class="sidebar-bottom">
      <div class="user-chip"><strong><%= currentUser.fullName %></strong><span><%= currentUser.role === 'admin' ? 'Administrator' : 'Sales Representative' %></span></div>
      <form method="POST" action="/logout">
        <button type="submit" class="nav-logout" aria-label="Logout"><span class="nav-icon">↪</span><span>Logout</span></button>
      </form>
    </div>
  </aside>
  <div class="app-main">
    <div class="flash-messages">
      <% if (flash && flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
      <% if (flash && flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>
    </div>
<% } %>
