<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container pos-layout">
  <div class="pos-products">
    <p class="eyebrow">DailyMart checkout</p>
    <h1>Point of Sale</h1>
    <div class="pos-toolbar">
      <input type="search" id="productSearch" placeholder="Search product or scan barcode..." aria-label="Search products" autofocus />
      <div class="category-filters" aria-label="Filter products by category">
        <button type="button" class="category-filter active" data-category="all">All products</button>
        <% categories.forEach(c => { %>
          <button type="button" class="category-filter" data-category="<%= c.id %>"><%= c.name %></button>
        <% }) %>
      </div>
    </div>
    <div class="product-grid" id="productGrid">
      <% products.forEach(p => { %>
        <button
          type="button"
          class="product-tile"
          data-id="<%= p.id %>"
          data-name="<%= p.name %>"
          data-price="<%= p.selling_price %>"
          data-stock="<%= p.stock_quantity %>"
          data-unit="<%= p.unit %>"
          data-category-id="<%= p.category_id || '' %>"
        >
          <span class="product-name"><%= p.name %></span>
          <span class="product-price"><%= peso(p.selling_price) %></span>
          <span class="product-category"><%= p.category_name || 'Uncategorized' %></span>
          <span class="product-stock"><%= p.stock_quantity %> <%= p.unit %> left</span>
        </button>
      <% }) %>
    </div>
    <p id="productMessage" class="muted" <%= products.length ? 'hidden' : '' %>>No in-stock products found.</p>
  </div>

  <div class="pos-cart">
    <h2>Current sale</h2>
    <table class="table" id="cartTable">
      <thead><tr><th>Item</th><th>Price</th><th>Qty</th><th>Subtotal</th><th></th></tr></thead>
      <tbody id="cartBody"></tbody>
    </table>
    <div class="cart-total">Total <span id="cartTotal">₱0.00</span></div>

    <form method="POST" action="/pos/checkout" id="checkoutForm">
      <input type="hidden" name="items" id="itemsInput" />
      <label>Amount Paid
        <input type="number" step="0.01" min="0" name="amount_paid" id="amountPaid" required inputmode="decimal" />
      </label>
      <div class="cart-change">Change: <span id="changeAmount">₱0.00</span></div>
      <button type="submit" class="btn btn-primary btn-block" id="checkoutBtn" disabled>Complete sale</button>
    </form>
  </div>
</main>
<script src="/js/pos.js"></script>
<%- include('../partials/foot') %>
